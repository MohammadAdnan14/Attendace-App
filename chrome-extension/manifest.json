{
  "manifest_version": 3,
  "name": "RBU Attendance Planner",
  "version": "1.0",
  "description": "Smart attendance calculator & What-If simulator for RBU students. Plan safe bunks, medical leaves, and hit 75% target.",
  "permissions": [],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://rcoem.in/studentCourseFileNew.htm*", "https://rcoem.in/studentCourseFileNew.htm?*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["qr.png", "icon16.png", "icon48.png", "icon128.png"],
      "matches": ["https://rcoem.in/*"]
    }
  ]
}
