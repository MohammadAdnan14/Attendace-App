{
  "manifest_version": 2,
  "name": "RBU Attendance Planner",
  "version": "1.0",
  "description": "Smart attendance calculator & What-If simulator for RBU students. Plan safe bunks, medical leaves, and hit 75% target.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://rcoem.in/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "web_accessible_resources": [
    "qr.png",
    "icon16.png",
    "icon48.png",
    "icon128.png"
  ]
} 