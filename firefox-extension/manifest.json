{
  "manifest_version": 2,
  "name": "RBU Attendance Planner",
  "version": "1.0.0",
  "description": "Smart attendance calculator & What-If simulator for RBU students. Plan safe bunks, medical leaves, and hit 75% target.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://rcoem.in/studentCourseFileNew.htm*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "*://rcoem.in/*",
    "storage"
  ],
  "web_accessible_resources": [
    "qr.png",
    "icon16.png",
    "icon48.png",
    "icon128.png"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rbu-attendance-planner@adnan.dev",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}